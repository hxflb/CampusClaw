SESSION_SECRET=
DB_HOST=db
DB_PORT=3306
DB_USER=campusclaw
DB_PASSWORD=
DB_NAME=campusclaw
MYSQL_ROOT_PASSWORD=
SEED_PASSWORD=
MAX_UPLOAD_BYTES=2097152
UPLOAD_DIR=/data/uploads
SESSION_TTL_HOURS=24
QDRANT_URL=http://qdrant:6333
VECTOR_SIZE=2048
# 在 https://ai-gateway.devops.hello1023.com/ 登录后，把控制台里的 Base URL 和 API Key 填到下面。
# Base URL 可以是 https://ai-gateway.devops.hello1023.com ，也可以是带 /v1 的地址。
# EMBEDDING_DIM 是向量长度，用来建库并核对返回维度，不作为嵌入请求参数。设置后优先于 VECTOR_SIZE。
EMBEDDING_DIM=2048
EMBEDDING_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=course-embedding
CHAT_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
CHAT_API_KEY=
CHAT_MODEL=course-chat
WEB_PORT=8080
# 与 mcp-demo 使用同一个令牌。只放在本机 .env，不要写入前端或提交到 Git。
MCP_AUTH_TOKEN=
LOGIN_FAIL_LIMIT=8
LOGIN_LOCK_SECONDS=60

# 第 6 课调用循环：一条提问最多几轮工具往返、总共最多几次调用
MCP_MAX_ROUNDS=3
MCP_MAX_CALLS=4
